# Your own Supabase project: Dashboard → Project Settings → API.
# Both values are public (they ship inside the app); never put the service_role / secret key here.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional crash reporting: Sentry → Settings → Projects → Client Keys (DSN). Public by design.
VITE_SENTRY_DSN=""
